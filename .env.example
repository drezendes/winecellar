# Reference of every env var. Copy to .env (gitignored) and fill it in. Dev
# needs only the Django + Claude blocks; the Production block is for the
# docker-compose.prod.yml deploy example (see deploy/README.md).

# --- Django ---
DEBUG=True
SECRET_KEY=generate-a-real-one-for-any-deployment
# ALLOWED_HOSTS=localhost,127.0.0.1
# TIME_ZONE=America/New_York
# CONSOLE_LOG_LEVEL=WARNING

# --- Claude API (https://platform.claude.com) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Distributor email polling (legacy IMAP ingress) ---
DISTRIBUTOR_IMAP_HOST=
DISTRIBUTOR_IMAP_USER=
DISTRIBUTOR_IMAP_PASSWORD=
# DISTRIBUTOR_IMAP_FOLDER=INBOX

# --- Distributor inbox (Email Worker -> webhook ingress) ---
# Bearer secret the Cloudflare Email Worker presents (blank = webhook disabled, 503):
DISTRIBUTOR_WEBHOOK_SECRET=
# Where recommendations are sent, and whose TasteProfile (buying notes + lens
# toggles) configures the analysis (username resolves the profile):
# DISTRIBUTOR_RECIPIENT=you@example.com
# DISTRIBUTOR_OWNER_USERNAME=owner
# Comma-separated categories to forward untouched instead of analyzing:
# DISTRIBUTOR_PASS_CATEGORIES=spirits / whiskey,beer,events / tastings,order confirmations / receipts

# --- Email sending (transactional SMTP, e.g. Resend) ---
# Blank password => console backend (dev/CI print); set it to enable real SMTP.
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=cellar@example.com

# ======================================================================
# Production only (docker-compose.prod.yml). NEVER commit real values.
# ======================================================================
# Django prod: DEBUG=False, a real 50+ char key, and the public origin.
#   SECRET_KEY: python -c "import secrets;print(secrets.token_urlsafe(64))"
# ALLOWED_HOSTS=wine.example.com
# CSRF_TRUSTED_ORIGINS=https://wine.example.com

# Site hostname for the Caddy vhost (docker-compose passes this to caddy):
# WINE_HOST=wine.example.com

# Postgres (compose builds DATABASE_URL from this):
#   POSTGRES_PASSWORD: python -c "import secrets;print(secrets.token_urlsafe(32))"
# POSTGRES_PASSWORD=

# Caddy TLS (Cloudflare DNS-01):
# CLOUDFLARE_API_TOKEN=    # Zone->DNS->Edit token
